# Normaliza todos os arquivos de texto para LF no repositório
* text=auto eol=lf

# Arquivos Go sempre LF
*.go text eol=lf

# Arquivos de configuração sempre LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.env* text eol=lf
*.toml text eol=lf

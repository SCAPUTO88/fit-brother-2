# ==============================================================================
# Fit Brother — Environment Variables
# Copie este arquivo para .env e preencha os valores
# NUNCA commitar o .env com valores reais
# ==============================================================================

# ------------------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Banco de Dados — Supabase PostgreSQL
# Obtenha em: supabase.com -> Project Settings -> Database -> Connection String
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Para desenvolvimento local (docker-compose):
# DATABASE_URL=postgres://fitbrother:secret@localhost:5432/fitbrother_db?sslmode=disable

# ------------------------------------------------------------------------------
# Rate Limiting em Memória (ADR-004 — Redis não é obrigatório)
# ------------------------------------------------------------------------------
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=1m

# ------------------------------------------------------------------------------
# Criptografia — CRÍTICO: gerar valores aleatórios e guardar em segredo
# ------------------------------------------------------------------------------

# AES-256-GCM key: DEVE ter exatamente 32 bytes em base64
# Gerar com: openssl rand -base64 32
AES_KEY=

# Pepper para HMAC-SHA256 do CPF (mínimo 32 caracteres)
# Gerar com: openssl rand -base64 32
CPF_HMAC_SECRET=

# Pepper para bcrypt de senhas (mínimo 32 caracteres)
# Gerar com: openssl rand -base64 32
PASSWORD_PEPPER=

# ------------------------------------------------------------------------------
# JWT — RS256 (chave assimétrica)
# Gerar com:
#   openssl genrsa -out secrets/jwt_rsa.pem 2048
#   openssl rsa -in secrets/jwt_rsa.pem -pubout -out secrets/jwt_rsa.pub.pem
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=./secrets/jwt_rsa.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_rsa.pub.pem
# Em PaaS de contêiner (Render, Fly.io, etc.), informe o conteúdo PEM completo em
# JWT_PRIVATE_KEY_PEM e JWT_PUBLIC_KEY_PEM juntos para substituir os caminhos acima.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h   # 7 dias

# ------------------------------------------------------------------------------
# Storage de Vídeos (ADR-005: local | r2 | disabled)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./tmp/storage
LOCAL_STORAGE_SIGNING_SECRET=
VIDEO_SIGNED_URL_TTL_MINUTES=5

# Obrigatório apenas quando STORAGE_DRIVER=r2 (Cloudflare R2 em homologação/produção)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fit-brother-videos
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# CORS (Wildcard '*' é proibido quando AllowCredentials=true — ADR-008)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SMTP Transacional (Opcional em dev — vazio usa NoopMailer; prod: Resend/Brevo)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fitbrother.local
SMTP_STARTTLS=true
